# -----------------------------------------------------------------------------
# Invariant properties for the 8-location search-and-rescue drone.
# All properties use [] only.
# -----------------------------------------------------------------------------

1: [] (
  B(searcher, mission(complete))
  ->
  (
    B(searcher, checked(l1)) &
    B(searcher, checked(l2)) &
    B(searcher, checked(l3)) &
    B(searcher, checked(l4)) &
    B(searcher, checked(l5)) &
    B(searcher, checked(l6)) &
    B(searcher, checked(l7)) &
    B(searcher, checked(l8))
  )
)


2: [] (
  ((B(searcher, mission(complete)) & B(searcher, human(l1))) -> B(searcher, aid_delivered(l1)))
  &
  ((B(searcher, mission(complete)) & B(searcher, human(l2))) -> B(searcher, aid_delivered(l2)))
  &
  ((B(searcher, mission(complete)) & B(searcher, human(l3))) -> B(searcher, aid_delivered(l3)))
  &
  ((B(searcher, mission(complete)) & B(searcher, human(l4))) -> B(searcher, aid_delivered(l4)))
  &
  ((B(searcher, mission(complete)) & B(searcher, human(l5))) -> B(searcher, aid_delivered(l5)))
  &
  ((B(searcher, mission(complete)) & B(searcher, human(l6))) -> B(searcher, aid_delivered(l6)))
  &
  ((B(searcher, mission(complete)) & B(searcher, human(l7))) -> B(searcher, aid_delivered(l7)))
  &
  ((B(searcher, mission(complete)) & B(searcher, human(l8))) -> B(searcher, aid_delivered(l8)))
)


3: [] (
  (B(searcher, checked(l1)) -> ~ (B(searcher, empty(l1)) & B(searcher, human(l1))))
  &
  (B(searcher, checked(l2)) -> ~ (B(searcher, empty(l2)) & B(searcher, human(l2))))
  &
  (B(searcher, checked(l3)) -> ~ (B(searcher, empty(l3)) & B(searcher, human(l3))))
  &
  (B(searcher, checked(l4)) -> ~ (B(searcher, empty(l4)) & B(searcher, human(l4))))
  &
  (B(searcher, checked(l5)) -> ~ (B(searcher, empty(l5)) & B(searcher, human(l5))))
  &
  (B(searcher, checked(l6)) -> ~ (B(searcher, empty(l6)) & B(searcher, human(l6))))
  &
  (B(searcher, checked(l7)) -> ~ (B(searcher, empty(l7)) & B(searcher, human(l7))))
  &
  (B(searcher, checked(l8)) -> ~ (B(searcher, empty(l8)) & B(searcher, human(l8))))
)


4: [] (
  (B(searcher, aid_delivered(l1)) -> B(searcher, human(l1)))
  &
  (B(searcher, aid_delivered(l2)) -> B(searcher, human(l2)))
  &
  (B(searcher, aid_delivered(l3)) -> B(searcher, human(l3)))
  &
  (B(searcher, aid_delivered(l4)) -> B(searcher, human(l4)))
  &
  (B(searcher, aid_delivered(l5)) -> B(searcher, human(l5)))
  &
  (B(searcher, aid_delivered(l6)) -> B(searcher, human(l6)))
  &
  (B(searcher, aid_delivered(l7)) -> B(searcher, human(l7)))
  &
  (B(searcher, aid_delivered(l8)) -> B(searcher, human(l8)))
)