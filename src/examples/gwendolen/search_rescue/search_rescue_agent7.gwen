GWENDOLEN

:name: searcher

:Initial Beliefs:

location(l1)
location(l2)
location(l3)
location(l4)
location(l5)
location(l6)
location(l7)

:Initial Goals:

mission(complete) [achieve]

:Plans:

+! mission(complete) [achieve]:
    {
      ~ B at(L0),
      B location(L),
      ~ B checked(L)
    }
<-
    fly_to(L),
    observe(L);


+! mission(complete) [achieve]:
    {
      B at(L),
      B resolved(L),
      B location(L1),
      ~ B checked(L1)
    }
<-
    fly_to(L1),
    observe(L1);


+! mission(complete) [achieve]:
    {
      B at(L),
      B human(L),
      ~ B aid_delivered(L)
    }
<-
    deliver_aid(L);


+! mission(complete) [achieve]:
    {
      B resolved(l1),
      B resolved(l2),
      B resolved(l3),
      B resolved(l4),
      B resolved(l5),
      B resolved(l6),
      B resolved(l7)
    }
<-
    complete_mission;