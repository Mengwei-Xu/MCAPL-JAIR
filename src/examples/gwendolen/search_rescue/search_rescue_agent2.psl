# -----------------------------------------------------------------------------
# Invariant properties for the 2-location search-and-rescue drone.
# All properties use [] only.
# -----------------------------------------------------------------------------

# 1. Mission completion implies full coverage.

1: [] (
  B(searcher, mission(complete))
  ->
  (
    B(searcher, checked(l1)) &
    B(searcher, checked(l2))
  )
)


# 2. Mission completion implies that every detected human has received aid.

2: [] (
  (
    (
      B(searcher, mission(complete)) &
      B(searcher, human(l1))
    )
    ->
    B(searcher, aid_delivered(l1))
  )
  &
  (
    (
      B(searcher, mission(complete)) &
      B(searcher, human(l2))
    )
    ->
    B(searcher, aid_delivered(l2))
  )
)


# 3. A checked location cannot be both empty and contain a human.

3: [] (
  (
    B(searcher, checked(l1))
    ->
    ~ (
      B(searcher, empty(l1))
      &
      B(searcher, human(l1))
    )
  )
  &
  (
    B(searcher, checked(l2))
    ->
    ~ (
      B(searcher, empty(l2))
      &
      B(searcher, human(l2))
    )
  )
)


# 4. Aid is delivered only where a human has been identified.

4: [] (
  (
    B(searcher, aid_delivered(l1))
    ->
    B(searcher, human(l1))
  )
  &
  (
    B(searcher, aid_delivered(l2))
    ->
    B(searcher, human(l2))
  )
)