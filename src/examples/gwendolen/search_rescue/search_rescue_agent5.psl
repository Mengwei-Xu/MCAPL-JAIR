# -----------------------------------------------------------------------------
# Invariant properties for the 5-location search-and-rescue drone.
# All properties use [] only.
# -----------------------------------------------------------------------------

1: [] (
  B(searcher, mission(complete))
  ->
  (
    B(searcher, checked(l1)) &
    B(searcher, checked(l2)) &
    B(searcher, checked(l3)) &
    B(searcher, checked(l4)) &
    B(searcher, checked(l5))
  )
)


2: [] (
  (
    (B(searcher, mission(complete)) & B(searcher, human(l1)))
    ->
    B(searcher, aid_delivered(l1))
  )
  &
  (
    (B(searcher, mission(complete)) & B(searcher, human(l2)))
    ->
    B(searcher, aid_delivered(l2))
  )
  &
  (
    (B(searcher, mission(complete)) & B(searcher, human(l3)))
    ->
    B(searcher, aid_delivered(l3))
  )
  &
  (
    (B(searcher, mission(complete)) & B(searcher, human(l4)))
    ->
    B(searcher, aid_delivered(l4))
  )
  &
  (
    (B(searcher, mission(complete)) & B(searcher, human(l5)))
    ->
    B(searcher, aid_delivered(l5))
  )
)


3: [] (
  (
    B(searcher, checked(l1))
    ->
    ~ (B(searcher, empty(l1)) & B(searcher, human(l1)))
  )
  &
  (
    B(searcher, checked(l2))
    ->
    ~ (B(searcher, empty(l2)) & B(searcher, human(l2)))
  )
  &
  (
    B(searcher, checked(l3))
    ->
    ~ (B(searcher, empty(l3)) & B(searcher, human(l3)))
  )
  &
  (
    B(searcher, checked(l4))
    ->
    ~ (B(searcher, empty(l4)) & B(searcher, human(l4)))
  )
  &
  (
    B(searcher, checked(l5))
    ->
    ~ (B(searcher, empty(l5)) & B(searcher, human(l5)))
  )
)


4: [] (
  (
    B(searcher, aid_delivered(l1))
    ->
    B(searcher, human(l1))
  )
  &
  (
    B(searcher, aid_delivered(l2))
    ->
    B(searcher, human(l2))
  )
  &
  (
    B(searcher, aid_delivered(l3))
    ->
    B(searcher, human(l3))
  )
  &
  (
    B(searcher, aid_delivered(l4))
    ->
    B(searcher, human(l4))
  )
  &
  (
    B(searcher, aid_delivered(l5))
    ->
    B(searcher, human(l5))
  )
)